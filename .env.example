# Use your own public Mapbox token (starts with pk.). Copy this file to .env.local.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Server-only Gemini key. Set in the Bilad host's private environment.
GEMINI_API_KEY=replace_with_your_server_side_key
# Optional Gemini model override.
GEMINI_MODEL=gemini-2.5-flash
